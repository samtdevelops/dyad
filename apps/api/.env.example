# Local Postgres from compose.yaml (dyad_dev database)
DATABASE_URL="postgresql://dyad:dyad@localhost:5432/dyad_dev"

# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Origin the browser uses. In dev that's the Vite server, which proxies /api to the API.
BETTER_AUTH_URL="http://localhost:5173"

PORT=3000
LOG_LEVEL="info"
